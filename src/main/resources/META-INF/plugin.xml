<idea-plugin>
    <id>io.github.hubertrybak.codestory</id>
    <name>Code Story</name>
    <vendor url="https://github.com/Hubert-Rybak/Jetbrains-Code-Story-Plugin">Hubert Rybak</vendor>
    <description><![CDATA[
        <p>Guided code stories for JetBrains IDEs. An AI agent sends a story through the IDE's MCP server
        (the <code>code_story_show</code> tool), or writes a story file when MCP is unavailable.
        The plugin installs the agent skill and checks setup. The Code Story tool window lists stories and their steps;
        a click on a step opens its file and highlights the lines that the step explains. Readers ask questions about
        steps, and the agent answers them inside the story (<code>code_story_feedback</code> and <code>code_story_reply</code>).</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="io.github.hubertrybak.codestory-mcp.xml">com.intellij.mcpServer</depends>
    <depends optional="true" config-file="io.github.hubertrybak.codestory-git.xml">Git4Idea</depends>

    <extensionPoints>
        <extensionPoint name="gitMetadata" interface="io.github.hubertrybak.codestory.StoryGitMetadata" dynamic="true"/>
        <extensionPoint name="mcpSupport" interface="io.github.hubertrybak.codestory.StoryMcpSupport" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="io.github.hubertrybak.codestory.CodeStoryStartup"/>
        <toolWindow id="Code Story" anchor="right" icon="AllIcons.Toolwindows.Documentation"
                    factoryClass="io.github.hubertrybak.codestory.CodeStoryToolWindowFactory"/>
        <notificationGroup id="Code Story" displayType="BALLOON"/>
        <applicationConfigurable parentId="tools" id="io.github.hubertrybak.codestory.settings"
                                 displayName="Code Story" instance="io.github.hubertrybak.codestory.CodeStoryConfigurable"/>
    </extensions>

    <actions>
        <group id="CodeStory.Setup" text="Code Story" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="CodeStory.InstallSkill" class="io.github.hubertrybak.codestory.InstallCodeStorySkillAction"
                    text="Install Code Story skill" description="Install or update the skill for your agents" icon="AllIcons.Actions.Download"/>
            <action id="CodeStory.CheckSetup" class="io.github.hubertrybak.codestory.CheckCodeStorySetupAction"
                    text="Check setup" description="Check the MCP server, registered tools and installed skills" icon="AllIcons.Actions.Checked"/>
        </group>
        <action id="CodeStory.NextStep" class="io.github.hubertrybak.codestory.ui.NextStepAction"
                text="Next Step" description="Play the next step, or finish the story" icon="AllIcons.Actions.Forward">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift Z" second-keystroke="RIGHT"/>
        </action>
        <action id="CodeStory.PreviousStep" class="io.github.hubertrybak.codestory.ui.PreviousStepAction"
                text="Previous Step" description="Play the previous step" icon="AllIcons.Actions.Back">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift Z" second-keystroke="LEFT"/>
        </action>
        <action id="CodeStory.StopStory" class="io.github.hubertrybak.codestory.ui.StopStoryAction"
                text="Stop Story" description="Stop playback and clear the story presentation" icon="AllIcons.Actions.Suspend">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift Z" second-keystroke="END"/>
        </action>
    </actions>
</idea-plugin>
