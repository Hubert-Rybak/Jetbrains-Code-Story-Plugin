<idea-plugin>
    <id>io.github.hubertrybak.codestory</id>
    <name>Code Story</name>
    <vendor url="https://github.com/Hubert-Rybak/Jetbrains-Code-Story-Plugin">Hubert Rybak</vendor>
    <description><![CDATA[
        <p>Guided code stories for JetBrains IDEs. An AI agent sends a story through the IDE's MCP server
        (the <code>code_story_show</code> tool). The Code Story tool window lists the stories and their steps;
        a click on a step opens its file and highlights the lines that the step explains.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="io.github.hubertrybak.codestory-mcp.xml">com.intellij.mcpServer</depends>
    <depends optional="true" config-file="io.github.hubertrybak.codestory-git.xml">Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Code Story" anchor="right" icon="AllIcons.Toolwindows.Documentation"
                    factoryClass="io.github.hubertrybak.codestory.CodeStoryToolWindowFactory"/>
        <notificationGroup id="Code Story" displayType="BALLOON"/>
    </extensions>
</idea-plugin>
